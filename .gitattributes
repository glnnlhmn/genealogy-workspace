# Default: auto-detect text files and normalize to LF
* text=auto eol=lf

# Python, config, docs, schemas, and shell scripts (strict LF)
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows-native scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (never touch line endings)
*.sqlite binary
*.sqlite3 binary
*.db binary
*.bk binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.pdf binary
*.zip binary
