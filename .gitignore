# ==============================================================================
# 7. Project Backups, Ephemeral Workspaces & Intake Staging
# ==============================================================================
*.bk
*.bak

# Isolated project Safe Backups (preserve directory structure via .gitkeep)
archive/backups_*/*
!archive/backups_*/.gitkeep
backups/*
!backups/.gitkeep

# Ephemeral runtime directories (preserve directories via .gitkeep)
download/*
!download/.gitkeep
temp/*
!temp/.gitkeep
gtemp/*
!gtemp/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Exclude staged evaluation miplets while allowing core prompts
prompts/core/miplets/

# ==============================================================================
# 8. Production Data Store, Database & Baseline Setup Whitelist
# ==============================================================================
# Universal database file ignores (sqlite3 / temporary journals / locks)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sqlite-journal
data/db/

# Ignore dynamic runtime data by default
data/*
!data/.gitkeep

# Track directory hierarchy via .gitkeep sentinels
!data/db/
!data/db/.gitkeep
!data/intake/
!data/intake/**/
!data/intake/**/.gitkeep

# Whitelist canonical shared reference datasets and system profiles
!data/profiles/
!data/profiles/**
!data/reference/
!data/reference/**

# Whitelist baseline setup datasets (locations and sites)
!data/setup/
!data/setup/**

# Whitelist canonical intake schemas and system skills
!schemas/
!schemas/**
!.skills/
!.skills/**

# Operator profile isolation (keep private)
glenn_profile.json
data/profiles/glenn_profile.json