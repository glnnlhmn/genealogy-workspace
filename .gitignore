# 7. Project Backups, Ephemeral Workspaces & Intake Staging
# ==============================================================================
*.bk
*.bak

# Isolated project Safe Backups (preserve directory structure via .gitkeep)
archive/backups_*/*
!archive/backups_*/.gitkeep
backups/*
!backups/.gitkeep

# Ephemeral runtime directories (preserve directories via .gitkeep)
download/*
!download/.gitkeep
temp/*
!temp/.gitkeep
gtemp/*
!gtemp/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep


