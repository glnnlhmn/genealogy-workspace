{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocationImportEnvelope",
  "type": "object",
  "required": ["schema_version", "locations"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "canonical_urn"],
        "properties": {
          "id": { "type": "string", "pattern": "^LOC-[0-9]{6}$" },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "COUNTRY",
              "STATOID",
              "COUNTY_EQUIVALENT",
              "CIVIL_TOWNSHIP",
              "MUNICIPALITY",
              "UNINCORPORATED_PLACE",
              "SPECIAL_DISTRICT"
            ]
          },
          "canonical_urn": { "type": "string", "pattern": "^urn:gda:loc:[a-z0-9_:\\-]+$" },
          "parent_id": { "type": ["string", "null"], "pattern": "^LOC-[0-9]{6}$" },
          "is_primary_local_authority": { "type": "boolean", "default": false },
          "is_unincorporated": { "type": "boolean", "default": false },
          "alternate_names": { "type": "array", "items": { "type": "string" }, "default": [] },
          "historical_names": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["raw_name", "canonical_name", "status"],
              "properties": {
                "raw_name": { "type": "string" },
                "canonical_name": { "type": "string" },
                "status": { "type": "string", "enum": ["HISTORICAL", "LEGAL", "FORMER", "COLLOQUIAL", "ARCHIVAL", "VARIANT"] }
              }
            },
            "default": []
          },
          "notes": { "type": "array", "items": { "type": "string", "pattern": "^NOT-[0-9]{6}$" }, "default": [] }
        }
      }
    }
  }
}